#!/usr/bin/env python3
"""Command-line entry point for the Kiln optimizer."""

import argparse
from pathlib import Path
import sys

# The grader expects the requested output to be the only file we write.
sys.dont_write_bytecode = True

from src.kirlib import KirError, check_machine_features, decode_text, load_machine, parse_program
from src.layout import load_profile
from src.optimizer import optimize
from src.finite import specialize
from src.candidates import select
from src.expansion import cache_loads, expand
from src.control import rewrite
from src.groups import candidates as group_candidates


def main():
    parser = argparse.ArgumentParser(description="Optimize KIR for a Kiln machine.")
    parser.add_argument("input", type=Path)
    parser.add_argument("--machine", type=Path, required=True)
    parser.add_argument("--profile", type=Path, help="optional branch counts for block layout")
    parser.add_argument("-o", dest="output", type=Path, required=True)
    parser.add_argument("--no-search", action="store_true", help="disable whole-function candidate search; keep standard passes and finite specialization")
    args = parser.parse_args()

    try:
        original = args.input.read_bytes()
        source = decode_text(original)
        program = parse_program(source)
        machine = load_machine(args.machine)
        check_machine_features(program, machine)
        profile = load_profile(args.profile)
        optimized = optimize(program, source, machine, profile)
        candidates = [optimized] if optimized is not None else []
        finite = specialize(parse_program(optimized) if optimized is not None else program, machine)
        if finite is not None:
            optimized = finite
            candidates.append(finite)
        if not args.no_search and 4 < len(program.instrs) <= 500 and len(program.block_labels) > 1:
            alternatives = [frozenset({"no_unroll"}), frozenset({"no_memory", "no_schedule", "no_alloc"}), frozenset({"nested"})]
            if any(ins.op == "mod" for ins in program.instrs):
                alternatives.append(frozenset({"defer_mod"}))
            for options in alternatives:
                candidate = optimize(parse_program(source), source, machine, profile, options)
                if candidate is not None:
                    candidates.append(candidate)
            expanded = expand(program)
            if expanded is not None:
                candidate = optimize(parse_program(expanded), expanded, machine)
                candidates.append(candidate if candidate is not None else expanded)
                cached = cache_loads(parse_program(expanded), min(16, max(4, machine["registers"])))
                if cached is not None:
                    candidate = optimize(parse_program(cached), cached, machine)
                    candidates.append(candidate if candidate is not None else cached)
            controls = []
            group_sources = [program]
            for mode in ('diamonds', 'guards', 'pointers'):
                rewritten = rewrite(program, mode)
                if rewritten is not None:
                    candidate = optimize(parse_program(rewritten), rewritten, machine, profile)
                    controls.append(candidate if candidate is not None else rewritten)
                    if mode == 'guards':group_sources.append(parse_program(rewritten))
                    if mode == 'pointers':
                        checked = rewrite(program, 'unroll')
                        if checked is not None:
                            candidate = optimize(parse_program(checked), checked, machine, profile)
                            controls.append(candidate if candidate is not None else checked)
                    if mode in ('guards', 'pointers'):
                        unrolled = rewrite(parse_program(rewritten), 'unroll')
                        if unrolled is not None:
                            candidate = optimize(parse_program(unrolled), unrolled, machine, profile)
                            controls.append(candidate if candidate is not None else unrolled)
            optimized = select(program, candidates, machine, profile)
            if controls:
                fallback = optimized if optimized is not None else source
                optimized = select(program, [fallback, *controls], machine, profile,
                                   diverse=True, fallback_source=fallback)
            grouped_controls = []
            for group_source in group_sources:
                for grouped in group_candidates(group_source):
                    candidate = optimize(parse_program(grouped), grouped, machine, profile)
                    grouped_controls.append(candidate if candidate is not None else grouped)
            if grouped_controls:
                fallback = optimized if optimized is not None else source
                optimized = select(program, [fallback, *grouped_controls], machine, profile,
                                   diverse=True, fallback_source=fallback, no_regressions=True)
        args.output.write_bytes(original if optimized is None else optimized.encode("utf-8"))
    except (KirError, OSError, ValueError) as error:
        print(f"kopt: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
